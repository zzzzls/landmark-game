  "narrative": {
    "northStar": "像素北京街机",
    "overview": "浅天空蓝界面与奶白面板承托真实地图，深海军蓝中文保证可读，金黄指向当前操作与关键成绩。北京城楼天际线、像素表情和方形关卡按钮带来街机感，中文与地图保持清晰。",
    "keyCharacteristics": [
      "浅蓝奶白表面、金黄动作、薄荷绿完成状态。",
      "原创SVG像素天际线与表情，本地像素数字字体。",
      "手机底部面板、桌面侧栏、大屏三题榜单。",
      "提交立即看个人成绩，全局揭晓再公布排名。"
    ],
    "rules": [],
    "dos": [
      "Do 保持中文可读，触控区域至少44px。",
      "Do 使用实际面板尺寸进行地图避让。",
      "Do 区分个人提交成绩与全场最终排名。",
      "Do 尊重减少动态效果，保留真实地图与版权。"
    ],
    "donts": [
      "Don't 将暗色主题和旧圆润票据混回当前亮色像素界面。",
      "Don't 在普通玩家入口提供建房或重开。",
      "Don't 暴露未公开的其他玩家答案或把缺失成绩当零分。",
      "Don't 将文档或截图视为完整游戏和30人真实设备验收。"
    ]
  }
