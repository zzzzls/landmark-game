      "html": "<label class=\"ds-label\" for=\"ds-nickname\">你的昵称<input id=\"ds-nickname\" class=\"ds-input\" placeholder=\"朋友们怎么称呼你？\" /></label>",
      "css": ".ds-label{display:block;font-family:-apple-system,BlinkMacSystemFont,\"PingFang SC\",\"Microsoft YaHei\",sans-serif;font-size:14px;font-weight:550;color:var(--ink,#252c2b);}.ds-input{display:block;width:100%;min-height:50px;margin-top:8px;padding:13px 15px;border:1px solid #bfc2b6;border-radius:10px;background:var(--surface,#fffdf8);color:var(--ink,#252c2b);font:400 16px/1.55 -apple-system,BlinkMacSystemFont,\"PingFang SC\",\"Microsoft YaHei\",sans-serif;caret-color:var(--accent,#ae3e2b);outline:none;}.ds-input::placeholder{color:var(--muted,#656a65);}.ds-input:focus,.ds-input:focus-visible{border-color:var(--accent,#ae3e2b);box-shadow:0 0 0 2px #ae3e2b20;}"
    },
