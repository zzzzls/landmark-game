      "css": ".ds-room-tabs{display:flex;padding:5px;gap:4px;border-radius:10px;background:#efefe5;font-family:-apple-system,BlinkMacSystemFont,\"PingFang SC\",\"Microsoft YaHei\",sans-serif;}.ds-room-tabs button{flex:1;min-height:44px;border:0;border-radius:7px;background:none;color:var(--muted,#656a65);font:inherit;font-size:13px;cursor:pointer;}.ds-room-tabs button[aria-pressed=\"true\"]{background:var(--surface,#fffdf8);color:var(--accent,#ae3e2b);box-shadow:0 2px 5px #252c2b0a;font-weight:650;}.ds-room-tabs button:focus-visible{outline:3px solid var(--accent,#ae3e2b);outline-offset:3px;}"
    },
    {
      "name": "题目选择",
      "kind": "chip",
